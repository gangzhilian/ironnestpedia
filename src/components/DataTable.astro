---
import { fieldLabel, translate, type Locale } from '../lib/data';
interface Props { rows: Record<string, any>[]; fields: string[]; locale?: Locale; }
const { rows, fields, locale = 'en' } = Astro.props;
const display = (value: any) => {
  if (value === null || value === undefined || value === '') return '—';
  if (typeof value === 'object') return JSON.stringify(value);
  return String(value);
};
---
{rows.length === 0 ? <p class="notice">{translate(locale, 'no_records')}</p> : (
  <div class="table-shell">
    <p class="table-scroll-hint" aria-hidden="true">{translate(locale, 'table_scroll_hint')}</p>
    <div class="table-wrap" role="region" aria-label={translate(locale, 'table_scroll_region')} tabindex="0">
      <table>
        <thead><tr>{fields.map((field) => <th scope="col">{fieldLabel(field, locale)}</th>)}</tr></thead>
        <tbody>{rows.map((row) => <tr>{fields.map((field) => <td><code>{display(row[field])}</code></td>)}</tr>)}</tbody>
      </table>
    </div>
  </div>
)}
