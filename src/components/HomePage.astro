---
import Layout from './Layout.astro';
import news from '../../data/live/news.json';
import { getHome, getSite, getTools, labelForRoute, localizedPath, routeMap, translate, type Locale } from '../lib/data';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const home = getHome(locale);
const site = getSite(locale);
const tools = getTools(locale);
const patchItems = news.raw_response?.appnews?.newsitems?.slice(0, 2) ?? [];
const videoGameJson = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: site.game_name,
  url: site.site_url,
  gamePlatform: 'Windows',
};
const hero = home.blocks.find((block: any) => block.order === 1);
const cards = home.blocks.find((block: any) => block.order === 2)?.cards ?? [];
---
<Layout title={site.home_seo.title} description={site.home_seo.description} path="/" locale={locale} schemas={[videoGameJson]}>
  <section class="home-hero" style={`--hero-background: url("${hero.background.asset}")`} aria-labelledby="homepage-h1">
    <div class="home-hero-content">
      <h1 id="homepage-h1" class="visually-hidden">{home.h1}</h1>
      <p class="hero-classification">{hero.eyebrow}</p>
      <div class="hero-display-title" aria-hidden="true">
        <span class="hero-title-primary">{hero.title.primary}</span>
        <span class="hero-title-secondary">{hero.title.subtitle}</span>
      </div>
      <p class="hero-hook">{hero.description}</p>

      <div class="hero-trust-row" aria-label="Site verification facts">
        {hero.hero_stats.map((stat: any) => (
          <div class="hero-stat" data-stat={stat.key}>
            <span>{stat.label}</span>
            {stat.verified_at && <time class="hero-stat-date" datetime={stat.verified_at}>Verified {stat.verified_at}</time>}
          </div>
        ))}
      </div>

      <div class="hero-cta-row">
        {hero.cta_buttons.map((cta: any) => (
          <a
            class:list={['hero-cta', cta.style === 'filled_accent' ? 'hero-cta-primary' : 'hero-cta-outline']}
            href={cta.url.startsWith('#') ? cta.url : localizedPath(cta.url, locale)}
          >{cta.label}</a>
        ))}
      </div>
      <p class="hero-dev-teaser">{hero.dev_teaser.label}</p>
    </div>
  </section>
  {/* TODO: Refresh the Steam review snapshot periodically. Current value was manually verified on 2026-08-24. */}
  <section>
    <h2>{tools.index.h1}</h2>
    <article class="card">
      <h3><a href={localizedPath('/tools/achievement-completion', locale)}>{tools.index.tool_name}</a></h3>
      <p>{tools.index.tool_description}</p>
      <p><a href={localizedPath('/tools', locale)}>{tools.index.open_tool}</a></p>
    </article>
  </section>
  <section id="database-matrix">
    <h2>{translate(locale, 'browse_database')}</h2>
    <div class="grid">
      {cards.map((card: any) => {
        const route = routeMap.get(card.url);
        const countText = translate(locale, card.type === 'index_only' ? 'verified_entries' : 'verified_pages', { count: card.count });
        return <article class="card"><h3><a href={localizedPath(card.url, locale)}>{card.label}</a></h3><p>{countText}</p>{route && <p class="meta">{labelForRoute(route, locale)}</p>}</article>;
      })}
    </div>
  </section>
  <section>
    <h2>{translate(locale, 'latest_updates')}</h2>
    <div class="grid">{patchItems.map((item: any) => <article class="card"><h3>{site.patch_titles[item.gid] ?? item.title}</h3><p>{new Date(item.date * 1000).toISOString().slice(0, 10)}</p><p><a href={localizedPath('/known-issues', locale)}>{translate(locale, 'view_tracker')}</a></p></article>)}</div>
  </section>
  <section class="panel">
    <h2>{translate(locale, 'data_provenance')}</h2>
    <p>{home.blocks.find((block: any) => block.order === 5)?.fields?.latest_version_label}</p>
    <p>{translate(locale, 'records_retain')}</p>
  </section>
</Layout>
