---
import '../styles/global.css';
import TechMark from './TechMark.astro';
import { getCompliance, getSite, getTools, localizedPath, ogImagePath, routes, translate, type Locale } from '../lib/data';

interface Props {
  title: string;
  description: string;
  path: string;
  locale?: Locale;
  noindex?: boolean;
  breadcrumbs?: { label: string; url?: string }[];
  schemas?: Record<string, any>[];
  image?: string;
}

const { title, description, path, locale = 'en', noindex = false, breadcrumbs = [], schemas = [], image } = Astro.props;
const site = getSite(locale);
const tools = getTools(locale);
const compliance = getCompliance(locale);
const pagePath = localizedPath(path, locale);
const canonical = new URL(pagePath, site.site_url).href;
const ogImage = new URL(image ?? ogImagePath(path, locale), site.site_url).href;
const breadcrumbItems = [{ label: site.ui.home, url: '/' }, ...breadcrumbs];
const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: new URL(localizedPath(item.url ?? path, locale), site.site_url).href,
  })),
};
const jsonLd = [...(breadcrumbItems.length > 1 ? [breadcrumbJson] : []), ...schemas];
const searchRoutes = routes.filter((route) => route.page_type !== 'tool_placeholder').map((route) => ({
  label: route.url_path,
  path: localizedPath(route.url_path, locale),
})).concat([
  { label: '/tools', path: localizedPath('/tools', locale) },
  { label: '/tools/achievement-completion', path: localizedPath('/tools/achievement-completion', locale) },
]);
searchRoutes.push(...['/about', '/privacy', '/cookies', '/terms', '/contact'].map((route) => ({
  label: route,
  path: localizedPath(route, locale),
})));
const languageLinks = site.languages.map((language) => ({
  ...language,
  path: localizedPath(path, language.code as Locale),
}));
---
<!doctype html>
<html lang={site.html_lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {!noindex && languageLinks.map((language) => <link rel="alternate" hreflang={language.hreflang} href={new URL(language.path, site.site_url).href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(path, site.site_url).href} />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.site_name} />
    <meta property="og:locale" content={site.html_lang.replace('-', '_')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    {!noindex && jsonLd.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{translate(locale, 'skip_to_content')}</a>
    <header>
      <div class="inner">
        <a class="brand" href={localizedPath('/', locale)}><TechMark size={25} />{site.site_name}</a>
        <nav aria-label={site.ui.primary_navigation}>
          {site.navigation.map((item) => <a href={localizedPath(item.url, locale)}>{item.label}</a>)}
        </nav>
        <nav class="language-switcher" aria-label={site.ui.language_switcher}>
          {languageLinks.map((language) => <a href={language.path} lang={language.hreflang} aria-current={language.code === locale ? 'page' : undefined}>{language.label}</a>)}
        </nav>
        <form id="site-search" role="search">
          <label class="eyebrow" for="site-query">{site.ui.quick_jump}</label>
          <input id="site-query" name="query" list="site-paths" placeholder={site.ui.search_placeholder} autocomplete="off" />
          <datalist id="site-paths">{searchRoutes.map((item) => <option value={item.label} />)}</datalist>
          <button type="submit">{site.ui.go}</button>
        </form>
      </div>
    </header>
    <main id="main-content">
      {breadcrumbItems.length > 1 && (
        <nav class="breadcrumbs" aria-label={site.ui.breadcrumb_navigation}>
          {breadcrumbItems.map((item, index) => <>{index > 0 && ' / '}{item.url ? <a href={localizedPath(item.url, locale)}>{item.label}</a> : item.label}</>)}
        </nav>
      )}
      <slot />
    </main>
    <footer>
      <div class="inner">
        <nav aria-label={site.ui.database_indexes}>
          {site.entity_indexes.map((item) => <a href={localizedPath(item.url, locale)}>{item.label}</a>)}
          <a class="footer-tools" href={localizedPath('/tools', locale)}>{tools.index.h1}</a>
          <a class="footer-about" href={localizedPath('/about', locale)}>{compliance.footer.about}</a>
          <a class="footer-privacy" href={localizedPath('/privacy', locale)}>{compliance.footer.privacy}</a>
          <a class="footer-cookies" href={localizedPath('/cookies', locale)}>{compliance.footer.cookies}</a>
          <a class="footer-terms" href={localizedPath('/terms', locale)}>{compliance.footer.terms}</a>
          <a class="footer-contact" href={localizedPath('/contact', locale)}>{site.contact.footer_label}</a>
        </nav>
        <p>{site.footer_disclaimer}</p>
      </div>
    </footer>
    <script define:vars={{ searchRoutes }}>
      document.querySelector('#site-search')?.addEventListener('submit', (event) => {
        event.preventDefault();
        const input = document.querySelector('#site-query');
        const value = input instanceof HTMLInputElement ? input.value.trim() : '';
        const match = searchRoutes.find((entry) => entry.label.toLowerCase() === value.toLowerCase());
        if (match) window.location.assign(match.path);
      });
    </script>
  </body>
</html>
