---
import '../styles/global.css';
import { getSite, localizedPath, routes, type Locale } from '../lib/data';

interface Props {
  title: string;
  description: string;
  path: string;
  locale?: Locale;
  noindex?: boolean;
  breadcrumbs?: { label: string; url?: string }[];
}

const { title, description, path, locale = 'en', noindex = false, breadcrumbs = [] } = Astro.props;
const site = getSite(locale);
const pagePath = localizedPath(path, locale);
const canonical = new URL(pagePath, site.site_url).href;
const ogImage = new URL('/og-default.svg', site.site_url).href;
const breadcrumbItems = [{ label: site.ui.home, url: '/' }, ...breadcrumbs];
const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.url ? { item: new URL(localizedPath(item.url, locale), site.site_url).href } : {}),
  })),
};
const searchRoutes = routes.filter((route) => route.page_type !== 'tool_placeholder').map((route) => ({
  label: route.url_path,
  path: localizedPath(route.url_path, locale),
}));
const languageLinks = site.languages.map((language) => ({
  ...language,
  path: localizedPath(path, language.code as Locale),
}));
---
<!doctype html>
<html lang={site.html_lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {!noindex && languageLinks.map((language) => <link rel="alternate" hreflang={language.hreflang} href={new URL(language.path, site.site_url).href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(path, site.site_url).href} />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)} />}
  </head>
  <body>
    <header>
      <div class="inner">
        <a class="brand" href={localizedPath('/', locale)}>{site.site_name}</a>
        <nav aria-label={site.ui.primary_navigation}>
          {site.navigation.map((item) => <a href={localizedPath(item.url, locale)}>{item.label}</a>)}
        </nav>
        <nav class="language-switcher" aria-label={site.ui.language_switcher}>
          {languageLinks.map((language) => <a href={language.path} lang={language.hreflang} aria-current={language.code === locale ? 'page' : undefined}>{language.label}</a>)}
        </nav>
        <form id="site-search" role="search">
          <label class="eyebrow" for="site-query">{site.ui.quick_jump}</label>
          <input id="site-query" name="query" list="site-paths" placeholder={site.ui.search_placeholder} autocomplete="off" />
          <datalist id="site-paths">{searchRoutes.map((item) => <option value={item.label} />)}</datalist>
          <button type="submit">{site.ui.go}</button>
        </form>
      </div>
    </header>
    <main>
      {breadcrumbItems.length > 1 && (
        <nav class="breadcrumbs" aria-label={site.ui.breadcrumb_navigation}>
          {breadcrumbItems.map((item, index) => <>{index > 0 && ' / '}{item.url ? <a href={localizedPath(item.url, locale)}>{item.label}</a> : item.label}</>)}
        </nav>
      )}
      <slot />
    </main>
    <footer>
      <div class="inner">
        <nav aria-label={site.ui.database_indexes}>
          {site.entity_indexes.map((item) => <a href={localizedPath(item.url, locale)}>{item.label}</a>)}
        </nav>
        <p>{site.footer_disclaimer}</p>
      </div>
    </footer>
    <script define:vars={{ searchRoutes }}>
      document.querySelector('#site-search')?.addEventListener('submit', (event) => {
        event.preventDefault();
        const input = document.querySelector('#site-query');
        const value = input instanceof HTMLInputElement ? input.value.trim() : '';
        const match = searchRoutes.find((entry) => entry.label.toLowerCase() === value.toLowerCase());
        if (match) window.location.assign(match.path);
      });
    </script>
  </body>
</html>
