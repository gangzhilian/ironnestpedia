---
import Layout from './Layout.astro';
import { getSite, localizedPath, translate, type Locale } from '../lib/data';
interface Props { path: string; title: string; reason: string; locale?: Locale; }
const { path, title: sourceTitle, reason: sourceReason, locale = 'en' } = Astro.props;
const copies: Record<Locale, Record<string, [string, string]>> = {
  en: {},
  'zh-cn': {
    '/guides': ['攻略', '步骤21不编写攻略文章。'],
    '/about': ['关于本站', '经审核的站点与数据来源说明属于步骤26。'],
    '/privacy': ['隐私政策', '本政策必须在步骤26中与实际部署的脚本保持一致。'],
    '/cookies': ['Cookie政策', '本政策必须在步骤26中与实际部署的脚本保持一致。'],
    '/terms': ['服务条款', '经审核的服务条款属于步骤26。'],
    '/contact': ['联系我们', '真实联系渠道将在步骤24或26提供。'],
  },
  'zh-tw': {
    '/guides': ['攻略', '步驟21不撰寫攻略文章。'],
    '/about': ['關於本站', '經審核的網站與資料來源說明屬於步驟26。'],
    '/privacy': ['隱私權政策', '本政策必須在步驟26中與實際部署的指令碼保持一致。'],
    '/cookies': ['Cookie政策', '本政策必須在步驟26中與實際部署的指令碼保持一致。'],
    '/terms': ['服務條款', '經審核的服務條款屬於步驟26。'],
    '/contact': ['聯絡我們', '實際聯絡管道將於步驟24或26提供。'],
  },
};
const [title, reason] = copies[locale][path] ?? [sourceTitle, sourceReason];
const site = getSite(locale);
---
<Layout title={`${title} | IronNestPedia`} description={reason} path={path} locale={locale} noindex breadcrumbs={[{ label: title }]}>
  <p class="eyebrow">{translate(locale, 'unpublished_section')}</p>
  <h1>{title}</h1>
  <p class="notice">{reason}</p>
  <p>{translate(locale, 'placeholder_body')}</p>
  <p><a href={localizedPath('/', locale)}>{translate(locale, 'return_home')}</a></p>
</Layout>
