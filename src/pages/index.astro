---
import Layout from '../components/Layout.astro';
import home from '../../data/en/home.json';
import news from '../../data/live/news.json';
import { getSeo, labelForRoute, routeMap, site } from '../lib/data';

const patchItems = news.raw_response?.appnews?.newsitems?.slice(0, 2) ?? [];
const videoGameJson = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: site.game_name,
  url: site.site_url,
  gamePlatform: 'Windows',
};
const featured = home.blocks.find((block) => block.order === 1)?.items ?? [];
const cards = home.blocks.find((block) => block.order === 2)?.cards ?? [];
---
<Layout title="IronNestPedia — IRON NEST Database, Guides & Tools" description="Explore verified IRON NEST shell, mission, achievement, medal, punchcard, mutator and unit data, with version and source metadata retained." path="/">
  <script type="application/ld+json" set:html={JSON.stringify(videoGameJson)} />
  <p class="eyebrow">IRON NEST verified data reference</p>
  <h1>{home.h1}</h1>
  <p>{site.data_note}</p>

  <section>
    <h2>Start with a current question</h2>
    <div class="grid">
      {featured.map((item) => item.linked && item.url ? (
        <article class="card">
          <h3><a href={item.url}>{item.label}</a></h3>
          <p>{getSeo(item.url).description}</p>
        </article>
      ) : (
        <article class="card teaser">
          <h3>{item.label}</h3>
          <p>Planned around the site’s verified shell fields; no inactive link is published.</p>
        </article>
      ))}
    </div>
  </section>

  <section>
    <h2>Browse the database</h2>
    <div class="grid">
      {cards.map((card) => {
        const route = routeMap.get(card.url);
        return <article class="card"><h3><a href={card.url}>{card.label}</a></h3><p>{card.count} verified {card.type === 'index_only' ? 'index entries' : 'pages'}.</p>{route && <p class="meta">{labelForRoute(route)}</p>}</article>;
      })}
    </div>
  </section>

  <section>
    <h2>Latest updates</h2>
    <div class="grid">{patchItems.map((item) => <article class="card"><h3>{item.title}</h3><p>{new Date(item.date * 1000).toISOString().slice(0, 10)}</p><p><a href="/known-issues">View the patch-verified issue tracker</a></p></article>)}</div>
  </section>

  <section class="panel">
    <h2>Data provenance</h2>
    <p>{home.blocks.find((block) => block.order === 5)?.fields?.latest_version_label}</p>
    <p>Entity records retain <code>game_version</code>, <code>data_source</code>, <code>last_updated</code>, and <code>confidence</code>.</p>
  </section>
</Layout>

