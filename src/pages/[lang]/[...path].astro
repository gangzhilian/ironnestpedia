---
import EntityPage from '../../components/EntityPage.astro';
import ContactPage from '../../components/ContactPage.astro';
import HomePage from '../../components/HomePage.astro';
import IndexPage from '../../components/IndexPage.astro';
import KnownIssuesPage from '../../components/KnownIssuesPage.astro';
import NotFoundPage from '../../components/NotFoundPage.astro';
import PlaceholderPage from '../../components/PlaceholderPage.astro';
import ToolsIndexPage from '../../components/ToolsIndexPage.astro';
import AchievementCompletionTool from '../../components/AchievementCompletionTool.astro';
import CompliancePage from '../../components/CompliancePage.astro';
import { getSite, placeholders, routes, type Locale, type RouteEntry } from '../../lib/data';

type ComplianceKey = 'privacy' | 'terms' | 'cookies' | 'about';
type Kind = 'home' | 'entity' | 'index' | 'known-issues' | 'contact' | 'tools' | 'achievement-completion' | 'compliance' | 'placeholder' | 'mission-map' | 'not-found';
interface Props { locale: Locale; kind: Kind; route?: RouteEntry; page?: { url_path: string; title: string; reason: string }; complianceKey?: ComplianceKey; }

export function getStaticPaths() {
  return (['zh-cn', 'zh-tw'] as Locale[]).flatMap((locale) => [
    { params: { lang: locale, path: undefined }, props: { locale, kind: 'home' as Kind } },
    { params: { lang: locale, path: 'contact' }, props: { locale, kind: 'contact' as Kind } },
    { params: { lang: locale, path: 'tools' }, props: { locale, kind: 'tools' as Kind } },
    { params: { lang: locale, path: 'tools/achievement-completion' }, props: { locale, kind: 'achievement-completion' as Kind } },
    ...(['about', 'privacy', 'cookies', 'terms'] as ComplianceKey[]).map((complianceKey) => ({
      params: { lang: locale, path: complianceKey },
      props: { locale, kind: 'compliance' as Kind, complianceKey },
    })),
    ...routes.map((route) => ({
      params: { lang: locale, path: route.url_path.slice(1) },
      props: {
        locale,
        route,
        kind: route.url_path === '/known-issues' ? 'known-issues' as Kind
          : route.page_type === 'tool_placeholder' ? 'mission-map' as Kind
          : route.page_type === 'index' ? 'index' as Kind : 'entity' as Kind,
      },
    })),
    ...placeholders.map((page) => ({ params: { lang: locale, path: page.url_path.slice(1) }, props: { locale, kind: 'placeholder' as Kind, page } })),
    { params: { lang: locale, path: '404' }, props: { locale, kind: 'not-found' as Kind } },
  ]);
}

const { locale, kind, route, page, complianceKey } = Astro.props as Props;
const site = getSite(locale);
---
{kind === 'home' && <HomePage locale={locale} />}
{kind === 'entity' && route && <EntityPage route={route} locale={locale} />}
{kind === 'index' && route && <IndexPage route={route} locale={locale} />}
{kind === 'known-issues' && <KnownIssuesPage locale={locale} />}
{kind === 'contact' && <ContactPage locale={locale} />}
{kind === 'tools' && <ToolsIndexPage locale={locale} />}
{kind === 'achievement-completion' && <AchievementCompletionTool locale={locale} />}
{kind === 'compliance' && complianceKey && <CompliancePage page={complianceKey} locale={locale} />}
{kind === 'placeholder' && page && <PlaceholderPage path={page.url_path} title={page.title} reason={page.reason} locale={locale} />}
{kind === 'mission-map' && route && <PlaceholderPage path={route.url_path} title={site.ui.mission_map_title} reason={site.ui.mission_map_reason} locale={locale} />}
{kind === 'not-found' && <NotFoundPage locale={locale} />}
